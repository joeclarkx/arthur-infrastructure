# systemd unit for self-hosted Umami on Arthur.
# Installed to /etc/systemd/system/umami.service by the deploy steps in
# docs/umami-deployment.md; then `systemctl daemon-reload && systemctl enable --now umami`.

[Unit]
Description=Umami analytics
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/umami
EnvironmentFile=/opt/umami/.env
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5
User=umami
Group=umami

[Install]
WantedBy=multi-user.target
