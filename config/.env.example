# Umami Configuration
# This is deployed as /opt/umami/.env on Arthur by scripts/setup.sh (which
# generates it automatically on first run). Kept here only as a reference.

DATABASE_URL=postgresql://umami:PASSWORD@localhost:5432/umami
APP_SECRET=generate-random-string-with-openssl-rand--hex-32
PORT=3002
# Pageviews from these IPs/CIDRs are discarded. Comma-separated.
IGNORE_IP=95.89.139.176
