# Template for /etc/multi-gmail-mcp.env (root:root, mode 600). Never commit real values.
# deploy.sh creates the real file on first run with ADMIN_PASSWORD and
# OAUTH_STATE_SECRET already generated; you only fill in the two Google values.

PORT=3003
PUBLIC_BASE_URL=https://mail.mcp.joeclark.photo
NODE_ENV=production
TOKEN_STORE=file
ALLOW_FILE_TOKEN_STORE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
OAUTH_STATE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENABLE_WRITE_TOOLS=true
LOG_LEVEL=info
