+import { createHmac } from 'node:crypto';
+import { Router } from 'express';
+import { getAccountStore } from './accountStore.js';
+import { loadConfig } from './config.js';
+import { getAttachment } from './gmail.js';
+import { log } from './logger.js';
+import { safeEqual } from './safeCompare.js';
+
+/** How long a download link works. A new one is a single tool call away. */
+export const LINK_TTL_SECONDS = 60 * 60;
+const MAX_BYTES = 25 * 1024 * 1024;
+
+interface LinkPayload {
+  a: string; // account alias
+  m: string; // message id
+  p: string; // part id
+  e: number; // expiry, unix seconds
+}
+
+function sign(payload: string): string {
+  // Domain-separated from the OAuth state signatures that share this secret.
+  return createHmac('sha256', loadConfig().oauthStateSecret).update(`attachment-link:${payload}`).digest('base64url');
+}
+
+/**
+ * Signed, expiring URL that streams one attachment straight from Gmail. Stateless:
+ * nothing is stored on this server, and the bytes never pass through the model.
+ */
+export function attachmentLink(alias: string, messageId: string, partId: string, filename: string) {
+  const expires = Math.floor(Date.now() / 1000) + LINK_TTL_SECONDS;
+  const payload = Buffer.from(JSON.stringify({ a: alias, m: messageId, p: partId, e: expires })).toString('base64url');
+  return {
+    url: `${loadConfig().publicBaseUrl}/attachments/${payload}.${sign(payload)}/${encodeURIComponent(filename)}`,
+    expires_at: new Date(expires * 1000).toISOString(),
+  };
+}
+
+export function verifyToken(token: string): LinkPayload | undefined {
+  const [payload, sig, extra] = token.split('.');
+  if (!payload || !sig || extra !== undefined || !safeEqual(sig, sign(payload))) return undefined;
+  const data = JSON.parse(Buffer.from(payload, 'base64url').toString('utf8')) as LinkPayload;
+  return data.e > Date.now() / 1000 ? data : undefined;
+}
+
+export function createAttachmentRouter(): Router {
+  const router = Router();
+  router.get('/:token/:name', async (req, res) => {
+    const link = verifyToken(req.params.token);
+    if (!link) {
+      res.status(403).type('text').send('Link invalid or expired. Ask Claude for a new one.');
+      return;
+    }
+    // Express 4 does not catch async errors, so everything that can throw stays in here.
+    try {
+      const record = await getAccountStore().get(link.a);
+      if (!record) {
+        res.status(404).type('text').send('Account no longer connected.');
+        return;
+      }
+      const att = await getAttachment(record.refreshToken, link.m, { partId: link.p }, MAX_BYTES);
+      if (att.truncated || !att.data_base64) {
+        res.status(413).type('text').send('Attachment too large.');
+        return;
+      }
+      log.info('attachment_download', { account: link.a, messageId: link.m, partId: link.p, size: att.size, sha256: att.sha256 });
+      res.setHeader('X-Content-Type-Options', 'nosniff');
+      res.setHeader('Cache-Control', 'no-store');
+      res.attachment(att.filename).type(att.mimeType).send(Buffer.from(att.data_base64, 'base64'));
+    } catch (err) {
+      log.error('attachment_download_failed', { account: link.a, message: (err as Error).message });
+      res.status(502).type('text').send('Fetching the attachment from Gmail failed.');
+    }
+  });
+  return router;
+}
