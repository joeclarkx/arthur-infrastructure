+/** Exact types, plus every Office Open XML type (docx, xlsx, pptx). text/plain: DB sends .ics files as it. */
+const ATTACHMENT_MIME_ALLOWLIST = new Set([
+  'application/pdf',
+  'image/png',
+  'image/jpeg',
+  'text/calendar',
+  'text/plain',
+  'application/octet-stream',
+]);
+const ATTACHMENT_MIME_PREFIX = 'application/vnd.openxmlformats-officedocument.';
+
+export class AttachmentSelectionError extends Error {}
+
+export interface AttachmentResult {
+  message_id: string;
+  part_id: string;
+  filename: string;
+  original_filename: string;
+  mimeType: string;
+  size: number;
+  truncated: boolean;
+  sha256?: string;
+  data_base64?: string;
+}
+
+/** Strips path separators and control characters so the name is safe to use as a file name. */
+export function sanitizeFilename(name: string): string {
+  const cleaned = name
+    .replace(/[/\\\x00-\x1f\x7f]/g, '_')
+    .replace(/^\.+/, '_')
+    .trim()
+    .slice(0, 255);
+  return cleaned || 'attachment';
+}
+
+/**
+ * Returns one attachment's bytes, base64-encoded, selected by partId (preferred) or
+ * exact filename. Nothing is written to disk and nothing is opened or parsed.
+ */
+export async function getAttachment(
+  refreshToken: string,
+  messageId: string,
+  select: { partId?: string; filename?: string },
+  maxBytes: number,
+): Promise<AttachmentResult> {
+  const client = clientForRefreshToken(refreshToken);
+  const encodedId = encodeMessageId(messageId);
+  const msg = await gmailFetch<GmailMessage>(client, `/messages/${encodedId}`, { format: 'full' });
+
+  const parts: GmailMessagePart[] = [];
+  (function walk(part: GmailMessagePart | undefined): void {
+    if (!part) return;
+    if (part.filename) parts.push(part);
+    for (const child of part.parts ?? []) walk(child);
+  })(msg.payload);
+
+  const matches =
+    select.partId !== undefined
+      ? parts.filter((p) => p.partId === select.partId)
+      : parts.filter((p) => p.filename === select.filename);
+  const wanted = select.partId !== undefined ? `part_id "${select.partId}"` : `filename "${select.filename}"`;
+  if (matches.length === 0) {
+    throw new AttachmentSelectionError(`No attachment with ${wanted} in message ${messageId}. Use get_email to list them.`);
+  }
+  if (matches.length > 1) {
+    throw new AttachmentSelectionError(`${matches.length} attachments match ${wanted} in message ${messageId}. Use part_id instead.`);
+  }
+  const part = matches[0]!;
+
+  const mimeType = (part.mimeType ?? 'application/octet-stream').toLowerCase();
+  if (!ATTACHMENT_MIME_ALLOWLIST.has(mimeType) && !mimeType.startsWith(ATTACHMENT_MIME_PREFIX)) {
+    throw new AttachmentSelectionError(`Attachment type "${mimeType}" is not on the allowlist.`);
+  }
+
+  const meta = {
+    message_id: messageId,
+    part_id: part.partId ?? '',
+    filename: sanitizeFilename(part.filename ?? ''),
+    original_filename: part.filename ?? '',
+    mimeType,
+  };
+  if ((part.body?.size ?? 0) > maxBytes) {
+    return { ...meta, size: part.body?.size ?? 0, truncated: true };
+  }
+
+  // Small parts can arrive inline; otherwise fetch by this response's attachmentId.
+  let data = part.body?.data;
+  if (!data && part.body?.attachmentId) {
+    const fetched = await gmailFetch<{ data?: string }>(
+      client,
+      `/messages/${encodedId}/attachments/${encodeURIComponent(part.body.attachmentId)}`,
+      {},
+    );
+    data = fetched.data;
+  }
+  const bytes = Buffer.from(data ?? '', 'base64url');
+  if (bytes.length > maxBytes) {
+    return { ...meta, size: bytes.length, truncated: true };
+  }
+  return {
+    ...meta,
+    size: bytes.length,
+    truncated: false,
+    sha256: createHash('sha256').update(bytes).digest('hex'),
+    data_base64: bytes.toString('base64'),
+  };
+}
